# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# CORS (restrict to GitHub Pages origin + localhost in production)
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://thechiragbatra.github.io"]

# Database (Supabase Postgres)
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/hireloop
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:password@localhost:5432/hireloop

# Resume processing
RESUME_TTL_SECONDS=3600
MAX_UPLOAD_MB=10
DELETE_ON_SESSION_END=true

# LLM Provider (bring-your-own-key supported)
LLM_PROVIDER=openrouter  # options: openrouter, openai, anthropic, ollama
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
CHEAP_MODEL_NAME=mistralai/mistral-small-latest
STRONG_MODEL_NAME=anthropic/claude-3.5-sonnet

# Embeddings / Reranker (hosted, 512 MB server limit)
EMBEDDER_PROVIDER=openrouter
EMBEDDER_API_KEY=
EMBEDDER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDER_MODEL_NAME=mistralai/mistral-small-latest
RERANKER_PROVIDER=openrouter
RERANKER_API_KEY=
RERANKER_BASE_URL=https://openrouter.ai/api/v1
RERANKER_MODEL_NAME=anthropic/claude-3.5-sonnet

# Rate limiting
SHARED_KEY_RATE_LIMIT_PER_MIN=10
RATE_LIMIT_ENABLED=true

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hireloop

# Job sources (public only)
ENABLE_ADZUNA=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ENABLE_REMOTEOK=true

# Supabase Auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Supabase Storage (private bucket, signed URLs)
SUPABASE_STORAGE_BUCKET=hireloop-resumes
SUPABASE_STORAGE_URL=

# Privacy
LOG_RESUME_TEXT=false  # NEVER set to true
