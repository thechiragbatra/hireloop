APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://thechiragbatra.github.io"]

# Local SQLite is used by default. Use a private Postgres URI in production.
DATABASE_URL=sqlite:///./data/hireloop.db
MAX_UPLOAD_MB=10

# Optional model assistance. Without a key, local matching and faithful copy-based tailoring run.
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
STRONG_MODEL_NAME=anthropic/claude-3.5-sonnet

# Required for production authentication; leave blank for local development.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=

SHARED_KEY_RATE_LIMIT_PER_MIN=60
LOG_RESUME_TEXT=false
